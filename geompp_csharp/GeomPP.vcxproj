    <Keyword>ManagedCProj</Keyword>
    <!--
      Targets .NET 8 (LTS). Change to net6.0-windows if needed.
      Requires Visual Studio 2022 with ".NET desktop development" workload installed.
    -->
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CLRSupport>NetCore</CLRSupport>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CLRSupport>NetCore</CLRSupport>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!--
    GeomppBuildRoot: root of the CMake Ninja build directory.
    Defaults to the VS CMake integration paths from CMakeSettings.json.
    Override from CI or command line: /p:GeomppBuildRoot="D:\a\geompp\geompp\build"
    The Condition ensures command-line /p: values always win.
  -->
  <PropertyGroup>
    <GeomppBuildRoot Condition="'$(GeomppBuildRoot)'=='' AND '$(Configuration)'=='Debug'">$(ProjectDir)..\out\build\x64-Debug</GeomppBuildRoot>
    <GeomppBuildRoot Condition="'$(GeomppBuildRoot)'=='' AND '$(Configuration)'=='Release'">$(ProjectDir)..\out\build\x64-Release</GeomppBuildRoot>
  </PropertyGroup>

  <!-- ── Debug ─────────────────────────────────────────────────────────── -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Disabled</Optimization>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions>GEOMPP_NO_THREAD_LOCAL;GLOG_USE_GLOG_EXPORT;_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\geompp\include;$(ProjectDir)src;$(GeomppBuildRoot)\_deps\glog-src\src;$(GeomppBuildRoot)\_deps\glog-build;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>
        $(GeomppBuildRoot)\geompp;
        $(GeomppBuildRoot)\geompp\Debug;
        $(GeomppBuildRoot)\_deps\glog-build;
        $(GeomppBuildRoot)\_deps\glog-build\Debug;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>glogd.lib;dbghelp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- ── Release ───────────────────────────────────────────────────────── -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions>GEOMPP_NO_THREAD_LOCAL;GLOG_USE_GLOG_EXPORT;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\geompp\include;$(ProjectDir)src;$(GeomppBuildRoot)\_deps\glog-src\src;$(GeomppBuildRoot)\_deps\glog-build;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>
        $(GeomppBuildRoot)\geompp;
        $(GeomppBuildRoot)\geompp\Release;
        $(GeomppBuildRoot)\_deps\glog-build;
        $(GeomppBuildRoot)\_deps\glog-build\Release;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>glog.lib;dbghelp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

