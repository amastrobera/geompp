<?xml version="1.0" encoding="utf-8"?>
<!--
  .NET Framework 4.8 build of the GeomPP C++/CLI bindings.
  Uses /clr (classic CLR) instead of /clr:netcore.
  Output goes to x64\Release_Net48\ to avoid colliding with the .NET 8 build.
  All source files are shared with GeomPP.vcxproj — do not duplicate logic here.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{B2C3D4E5-F6A7-8901-BCDE-F12345678901}</ProjectGuid>
    <RootNamespace>GeomPP</RootNamespace>
    <Keyword>ManagedCProj</Keyword>
    <!--
      Targets .NET Framework 4.8.
      Requires Visual Studio 2022 with "Desktop development with C++" workload.
      No TargetFramework property here — that is .NET Core/5+ syntax.
    -->
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <TargetName>GeomPP</TargetName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CLRSupport>true</CLRSupport>   <!-- /clr — classic CLR for .NET Framework -->
    <CharacterSet>Unicode</CharacterSet>
    <OutDir>$(Platform)\$(Configuration)_Net48\</OutDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CLRSupport>true</CLRSupport>   <!-- /clr — classic CLR for .NET Framework -->
    <CharacterSet>Unicode</CharacterSet>
    <OutDir>$(Platform)\$(Configuration)_Net48\</OutDir>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!--
    GeomppBuildRoot: root of the CMake Ninja build directory.
    Same semantics as GeomPP.vcxproj. Override with /p:GeomppBuildRoot=...
  -->
  <PropertyGroup>
    <GeomppBuildRoot Condition="'$(GeomppBuildRoot)'=='' AND '$(Configuration)'=='Debug'">$(ProjectDir)..\out\build\x64-Debug</GeomppBuildRoot>
    <GeomppBuildRoot Condition="'$(GeomppBuildRoot)'=='' AND '$(Configuration)'=='Release'">$(ProjectDir)..\out\build\x64-Release</GeomppBuildRoot>
  </PropertyGroup>

  <!-- ── Debug ─────────────────────────────────────────────────────────── -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Disabled</Optimization>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\geompp\include;$(ProjectDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>
        $(GeomppBuildRoot)\geompp;
        $(GeomppBuildRoot)\geompp\Debug;
        $(GeomppBuildRoot)\_deps\glog-build;
        $(GeomppBuildRoot)\_deps\glog-build\Debug;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>geompp.lib;glogd.lib;dbghelp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- ── Release ───────────────────────────────────────────────────────── -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\geompp\include;$(ProjectDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>
        $(GeomppBuildRoot)\geompp;
        $(GeomppBuildRoot)\geompp\Release;
        $(GeomppBuildRoot)\_deps\glog-build;
        $(GeomppBuildRoot)\_deps\glog-build\Release;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>geompp.lib;glog.lib;dbghelp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <!-- ── Source files (shared with GeomPP.vcxproj) ────────────────────── -->
  <ItemGroup>
    <ClCompile Include="src\Precision.cpp" />
    <ClCompile Include="src\Point2D.cpp" />
    <ClCompile Include="src\Vector2D.cpp" />
    <ClCompile Include="src\Point3D.cpp" />
    <ClCompile Include="src\Vector3D.cpp" />
    <ClCompile Include="src\Line2D.cpp" />
    <ClCompile Include="src\Ray2D.cpp" />
    <ClCompile Include="src\LineSegment2D.cpp" />
    <ClCompile Include="src\Line3D.cpp" />
    <ClCompile Include="src\Ray3D.cpp" />
    <ClCompile Include="src\LineSegment3D.cpp" />
    <ClCompile Include="src\Polyline2D.cpp" />
    <ClCompile Include="src\Polyline3D.cpp" />
    <ClCompile Include="src\Polygon2D.cpp" />
    <ClCompile Include="src\Polygon3D.cpp" />
    <ClCompile Include="src\Triangle2D.cpp" />
    <ClCompile Include="src\Triangle3D.cpp" />
    <ClCompile Include="src\BBox2D.cpp" />
    <ClCompile Include="src\BBox3D.cpp" />
    <ClCompile Include="src\Plane.cpp" />
    <ClCompile Include="src\WktParser.cpp" />
    <ClCompile Include="src\GeometryCollection2D.cpp" />
    <ClCompile Include="src\GeometryCollection3D.cpp" />
    <ClCompile Include="src\GeomUtil.cpp" />
    <ClCompile Include="src\IntersectionEvent2D.cpp" />
    <ClCompile Include="src\CoordinateFrame.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="src\Precision.hpp" />
    <ClInclude Include="src\Point2D.hpp" />
    <ClInclude Include="src\Vector2D.hpp" />
    <ClInclude Include="src\Point3D.hpp" />
    <ClInclude Include="src\Vector3D.hpp" />
    <ClInclude Include="src\Line2D.hpp" />
    <ClInclude Include="src\Ray2D.hpp" />
    <ClInclude Include="src\LineSegment2D.hpp" />
    <ClInclude Include="src\Line3D.hpp" />
    <ClInclude Include="src\Ray3D.hpp" />
    <ClInclude Include="src\LineSegment3D.hpp" />
    <ClInclude Include="src\Polyline2D.hpp" />
    <ClInclude Include="src\Polyline3D.hpp" />
    <ClInclude Include="src\Polygon2D.hpp" />
    <ClInclude Include="src\Polygon3D.hpp" />
    <ClInclude Include="src\Triangle2D.hpp" />
    <ClInclude Include="src\Triangle3D.hpp" />
    <ClInclude Include="src\BBox2D.hpp" />
    <ClInclude Include="src\BBox3D.hpp" />
    <ClInclude Include="src\Plane.hpp" />
    <ClInclude Include="src\WktParser.hpp" />
    <ClInclude Include="src\GeometryCollection2D.hpp" />
    <ClInclude Include="src\GeometryCollection3D.hpp" />
    <ClInclude Include="src\GeomUtil.hpp" />
    <ClInclude Include="src\IntersectionEvent2D.hpp" />
    <ClInclude Include="src\CoordinateFrame.hpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

</Project>
