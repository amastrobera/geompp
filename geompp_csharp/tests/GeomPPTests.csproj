<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      GeomPPConfiguration: which build of GeomPP.dll to reference.
      Defaults to Release. Override at the command line:
        dotnet run -p:GeomPPConfiguration=Debug
    -->
    <GeomPPConfiguration Condition="'$(GeomPPConfiguration)'==''">Release</GeomPPConfiguration>
    <GeomPPDllDir>$(MSBuildProjectDirectory)\..\x64\$(GeomPPConfiguration)</GeomPPDllDir>
  </PropertyGroup>

  <!--
    Reference GeomPP.dll (C++/CLI mixed-mode assembly).
    Private=true (CopyLocal) copies it to the output directory.
    Ijwhost.dll is the C++/CLI IJW bootstrap shim that GeomPP.dll
    depends on natively — it must sit next to GeomPP.dll at runtime.
  -->
  <ItemGroup>
    <Reference Include="GeomPP">
      <HintPath>$(GeomPPDllDir)\GeomPP.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(GeomPPDllDir)\Ijwhost.dll"
             Condition="Exists('$(GeomPPDllDir)\Ijwhost.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Ijwhost.dll</Link>
    </Content>
  </ItemGroup>

</Project>
