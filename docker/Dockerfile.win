# Windows Server Core — requires Docker Desktop in Windows containers mode
FROM mcr.microsoft.com/windows/servercore:ltsc2022

SHELL ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]

# Install Chocolatey
RUN [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; \
    Invoke-WebRequest -Uri https://community.chocolatey.org/install.ps1 -UseBasicParsing | Invoke-Expression

# Install build tools and utilities
RUN choco install -y cmake --installargs 'ADD_CMAKE_TO_PATH=System'
RUN choco install -y ninja
RUN choco install -y git
RUN choco install -y nuget.commandline
RUN choco install -y dotnet-8.0-sdk
RUN choco install -y vim

# Install VS 2022 Build Tools:
#   VCTools       — MSVC compiler, linker, CMake integration, C++/CLI support
#   ManagedDesktop — MSBuild + .NET desktop targeting packs
#   Net48Pack     — .NET Framework 4.8 targeting pack (for GeomPP_Net48.vcxproj)
RUN choco install -y visualstudio2022buildtools --package-parameters \
    "'--add Microsoft.VisualStudio.Workload.VCTools \
      --add Microsoft.VisualStudio.Workload.ManagedDesktopBuildTools \
      --add Microsoft.Net.Component.4.8.TargetingPack \
      --includeRecommended --quiet --norestart'"

# Create developer user and workspace
RUN net user developer /add /passwordreq:no
RUN mkdir C:\Users\developer\workspace

WORKDIR C:/Users/developer/workspace

USER developer

# Start an interactive cmd session with the VS x64 environment pre-loaded.
# This puts cl.exe, msbuild, cmake (VS-bundled), ninja on PATH automatically.
CMD ["cmd", "/k", "C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\Common7\\Tools\\VsDevCmd.bat -arch=amd64"]
