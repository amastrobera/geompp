FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    sudo \
    vim \
    nano \
    wget \
    make \
    cmake \
    build-essential \
    gdb \
    valgrind \
    software-properties-common \
    net-tools \
    libgtest-dev \
    git \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Python build tools for the Python bindings
RUN pip3 install --break-system-packages scikit-build-core pybind11 pytest

# Set up user
RUN useradd --create-home --groups sudo --shell /bin/bash developer \
    && mkdir -p /etc/sudoers.d \
    && echo "developer ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/developer \
    && chmod 0440 /etc/sudoers.d/developer

# Set the working directory and default entrypoint
USER developer
ENV HOME=/home/developer
WORKDIR /home/developer/workspace/geompp
ENTRYPOINT ["/bin/bash"]
